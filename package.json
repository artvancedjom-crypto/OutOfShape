{
  "name": "outofshape-lab",
  "productName": "OutOfShape Lab",
  "private": true,
  "version": "1.1.0",
  "description": "PLC + circuit simulation lab with a PDF note-taking editor. Runs in the browser and as a Windows desktop app.",
  "author": "OutOfShape",
  "repository": "github:artvancedjom-crypto/OutOfShape",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "desktop": "npm run build && electron .",
    "dist": "node scripts/dist.mjs all",
    "dist:portable": "node scripts/dist.mjs portable",
    "dist:installer": "node scripts/dist.mjs installer",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "perfect-freehand": "1.2.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "5.4.21"
  }
}
